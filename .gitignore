# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# service account keys (never commit)
# scripts/*.ts 의 --key 인자로 저장소 안에 두게 되는 경우가 있어 미리 차단한다.
# *-firebase-adminsdk-*.json 은 Firebase 콘솔에서 받을 때의 기본 파일명.
serviceAccount*.json
service-account*.json
*-firebase-adminsdk-*.json

# vercel
.vercel

# migration reports
/invoice-link-report-*.json

# typescript
*.tsbuildinfo
next-env.d.ts
